  "keyFeatures": [
    "Kasboek met live balans, categorieën en werkjaarfilter",
    "Automatische bankimport via CSV (KBC, Belfius, ING)",
    "Slimme betalingsopvolging met fuzzy matching",
    "Webshop voor wafelverkoop, kampen en andere verkoopmomenten",
    "Onkostenbeheer met OCR bonnetjescan voor leiders",
    "Volledig ledenbeheer met takken, inschrijvingsformulier en medische fiche",
    "Ouder- en voogdportal voor herinschrijving",
    "Jaarrapport genereren in één klik",
    "Admin- en memberrollen met auditkoppeling",
    "AI-assistent voor financiële inzichten",
    "Aanpasbare huisstijl (logo, primaire kleur) in webshop",
    "Betalingsherinneringen per e-mail met IBAN en QR-code",
    "Multi-vereniging (company switching)",
    "Abonnementen: Free, Basic, Pro, Premium"
  ],
